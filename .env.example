# =============================================================================
# AI Blog Platform — Environment Variables
# Copy this file to .env and fill in real values. Never commit .env.
# =============================================================================

# --- Database (required) -----------------------------------------------------
# Any managed Postgres works: Neon, Supabase, Railway, RDS, Vercel Postgres...
DATABASE_URL="postgresql://user:password@host:5432/ai_blog_platform?schema=public"

# --- Auth (required) ----------------------------------------------------------
# Generate with: openssl rand -base64 32
# NOTE: next-auth v4 reads NEXTAUTH_SECRET specifically — this exact name is required.
NEXTAUTH_SECRET="replace-with-a-random-32-byte-secret"
NEXTAUTH_URL="http://localhost:3000"

# --- AI providers (at least one required for real content generation) --------
# Without either key set, the platform automatically falls back to the
# built-in MOCK provider (src/lib/ai/mock-provider.ts) so the app still runs
# end-to-end with deterministic, offline-generated demo content.
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""
AI_DEFAULT_PROVIDER="anthropic"      # anthropic | openai | mock
AI_ECONOMY_MODEL="claude-haiku-4-5-20251001"
AI_PREMIUM_MODEL="claude-sonnet-4-6"

# --- AI budget guard (Phase 19 — hard requirement, never spend unbounded) -----
# At 80% of either budget: a warning SystemAlert is logged (and emailed if
# EMAIL_SERVER_* is configured). At 100%: automation jobs skip non-essential
# AI calls — the site itself and already-published content are unaffected.
AI_DAILY_BUDGET_USD="5"
AI_MONTHLY_BUDGET_USD="100"

# --- Storage (required for real image uploads) --------------------------------
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
# Or, if using S3-compatible storage instead of Cloudinary:
S3_ENDPOINT=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_REGION=""

# --- Analytics integrations (optional, dashboard falls back to internal data) -
GOOGLE_ANALYTICS_PROPERTY_ID=""
GOOGLE_SERVICE_ACCOUNT_EMAIL=""
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=""
GOOGLE_SEARCH_CONSOLE_SITE_URL=""

# --- Email / newsletter (required for real sending) ---------------------------
EMAIL_SERVER_HOST="smtp.resend.com"
EMAIL_SERVER_PORT="465"
EMAIL_SERVER_USER=""
EMAIL_SERVER_PASSWORD=""
EMAIL_FROM="newsletter@yourdomain.com"

# --- Automation / cron ---------------------------------------------------------
# Shared secret checked by every /api/automation/* route so cron calls can't
# be triggered by random requests. Vercel Cron sends this as a header.
CRON_SECRET="replace-with-a-random-secret"

# --- Affiliate networks (optional — add the ones you actually use) ------------
AMAZON_ASSOCIATES_TAG=""
AWIN_API_TOKEN=""
IMPACT_ACCOUNT_SID=""
IMPACT_AUTH_TOKEN=""

# --- App -----------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NODE_ENV="development"

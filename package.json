{
  "name": "ai-blog-platform",
  "version": "0.1.0",
  "private": true,
  "description": "AI-managed, multi-blog, monetized content platform (Next.js + Prisma + Postgres)",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "job:discover-keywords": "tsx src/lib/automation/jobs/discover-keywords.ts",
    "job:generate-briefs": "tsx src/lib/automation/jobs/generate-briefs.ts",
    "job:generate-articles": "tsx src/lib/automation/jobs/generate-articles.ts",
    "job:detect-decay": "tsx src/lib/automation/jobs/detect-decay.ts",
    "job:weekly-report": "tsx src/lib/automation/jobs/weekly-report.ts",
    "engines:selftest": "tsx scripts/test-engines.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "next": "14.2.21",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "@prisma/client": "^5.22.0",
    "next-auth": "^4.24.10",
    "bcryptjs": "^2.4.3",
    "zod": "^3.24.1",
    "@anthropic-ai/sdk": "^0.32.0",
    "openai": "^4.73.0",
    "recharts": "^2.13.3",
    "lucide-react": "^0.468.0",
    "date-fns": "^4.1.0",
    "slugify": "^1.6.6",
    "cloudinary": "^2.5.1",
    "nodemailer": "^6.9.16",
    "clsx": "^2.1.1",
    "tailwind-merge": "^2.5.5",
    "rate-limiter-flexible": "^5.0.5",
    "react-markdown": "^9.0.1"
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "tsx": "^4.19.2",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.15",
    "@tailwindcss/typography": "^0.5.15",
    "postcss": "^8.4.49",
    "autoprefixer": "^10.4.20",
    "@types/node": "^22.10.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/nodemailer": "^6.4.17",
    "eslint": "^8.57.1",
    "eslint-config-next": "14.2.21",
    "vitest": "^2.1.6"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}